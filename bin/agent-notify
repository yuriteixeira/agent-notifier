#!/usr/bin/env bash

agent_notify_dirname() {
  case "$1" in
    */*) printf '%s\n' "${1%/*}" ;;
    *) printf '.\n' ;;
  esac
}

agent_notify_abs_dir() {
  agent_notify_path_dir=$(agent_notify_dirname "$1")
  CDPATH= cd -- "$agent_notify_path_dir" && pwd
}

agent_notify_script_path=${BASH_SOURCE[0]}
agent_notify_script_dir=$(agent_notify_abs_dir "$agent_notify_script_path") || {
  printf 'agent-notify: could not resolve script directory\n' >&2
  exit 70
}

agent_notify_default_lib_dir=$agent_notify_script_dir/../lib/agent-notify
agent_notify_symlink_lib_dir=

if [ -L "$agent_notify_script_path" ] && command -v readlink >/dev/null 2>&1; then
  agent_notify_link_target=$(readlink "$agent_notify_script_path" 2>/dev/null || true)
  if [ -n "$agent_notify_link_target" ]; then
    case "$agent_notify_link_target" in
      /*) agent_notify_target_path=$agent_notify_link_target ;;
      *) agent_notify_target_path=$agent_notify_script_dir/$agent_notify_link_target ;;
    esac
    agent_notify_target_dir=$(agent_notify_abs_dir "$agent_notify_target_path" 2>/dev/null || true)
    if [ -n "$agent_notify_target_dir" ]; then
      agent_notify_symlink_lib_dir=$agent_notify_target_dir/../lib/agent-notify
    fi
  fi
fi

if [ -n "${AGENT_NOTIFY_LIB_DIR:-}" ]; then
  agent_notify_lib_dir=$AGENT_NOTIFY_LIB_DIR
elif [ -d "$agent_notify_default_lib_dir" ]; then
  agent_notify_lib_dir=$agent_notify_default_lib_dir
elif [ -n "$agent_notify_symlink_lib_dir" ] && [ -d "$agent_notify_symlink_lib_dir" ]; then
  agent_notify_lib_dir=$agent_notify_symlink_lib_dir
else
  agent_notify_lib_dir=$agent_notify_default_lib_dir
fi

for agent_notify_module in core tmux notify_local notify_tmux notify_ntfy notify cli; do
  agent_notify_module_path=$agent_notify_lib_dir/$agent_notify_module.sh
  if [ ! -f "$agent_notify_module_path" ]; then
    printf 'agent-notify: missing module: %s\n' "$agent_notify_module_path" >&2
    exit 70
  fi
  . "$agent_notify_module_path"
done

main "$@"
exit 0
